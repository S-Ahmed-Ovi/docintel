# copy to .env
API_KEY=change-me-to-a-long-random-string
GEMINI_API_KEY=               # enables Gemini extraction (get one at https://aistudio.google.com/apikey)
GEMINI_MODEL=gemini-2.5-flash # change if Google has renamed/retired this model
LLM_PROVIDER=auto             # auto|gemini|anthropic ; empty keys = rule-based extractor
ANTHROPIC_API_KEY=            # optional alternative to Gemini
LLM_MODEL=claude-sonnet-4-5
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_MB=50
WORKER_THREADS=2
